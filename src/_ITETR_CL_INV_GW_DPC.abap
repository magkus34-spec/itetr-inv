*-------------------------------------------------------------
*  Map the runtime request to the RFC - Only mapped attributes
*-------------------------------------------------------------
* Get all input information from the technical request context object
* Since DPC works with internal property names and runtime API interface holds external property names
* the process needs to get the all needed input information from the technical request context object
* Get filter or select option information
  lo_filter = io_tech_request_context->get_filter( ).
  lt_filter_select_options = lo_filter->get_filter_select_options( ).
  lv_filter_str = lo_filter->get_filter_string( ).

* Check if the supplied filter is supported by standard gateway runtime process
  IF  lv_filter_str            IS NOT INITIAL
  AND lt_filter_select_options IS INITIAL.
    " If the string of the Filter System Query Option is not automatically converted into
    " filter option table (lt_filter_select_options), then the filtering combination is not supported
    " Log message in the application log
    me->/iwbep/if_sb_dpc_comm_services~log_message(
      EXPORTING
        iv_msg_type   = 'E'
        iv_msg_id     = '/IWBEP/MC_SB_DPC_ADM'
        iv_msg_number = 025 ).
     " Raise Exception
     RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception
       EXPORTING
         textid = /iwbep/cx_mgw_tech_exception=>internal_error.
  ENDIF.

* Get key table information
  io_tech_request_context->get_converted_source_keys(
    IMPORTING
      es_key_values  = ls_converted_keys ).

  ls_paging-top = io_tech_request_context->get_top( ).
  ls_paging-skip = io_tech_request_context->get_skip( ).

* Maps filter table lines to function module parameters
  LOOP AT lt_filter_select_options INTO ls_filter.

    LOOP AT ls_filter-select_options INTO ls_filter_range.
      CASE ls_filter-property.
      WHEN 'P_STATS'.
        lo_filter->convert_select_option(
          EXPORTING
            is_select_option = ls_filter
          IMPORTING
            et_select_option = lr_P_STATS ).

        READ TABLE lr_P_STATS INTO ls_P_STATS INDEX 1.
        IF sy-subrc = 0.
          p_stats = ls_P_STATS-low.
        ENDIF.
      WHEN 'P_BUKRS'.
        lo_filter->convert_select_option(
          EXPORTING
            is_select_option = ls_filter
          IMPORTING
            et_select_option = lr_P_BUKRS ).

        READ TABLE lr_P_BUKRS INTO ls_P_BUKRS INDEX 1.
        IF sy-subrc = 0.
          p_bukrs = ls_P_BUKRS-low.
        ENDIF.
    WHEN 'XBLNR_FICA'.              " Equivalent to 'XblnrFica' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_XBLNR_FICA ).

        LOOP AT lr_XBLNR_FICA INTO ls_XBLNR_FICA.
               ls_s_xblnr_fica-high = ls_XBLNR_FICA-high.
               ls_s_xblnr_fica-low = ls_XBLNR_FICA-low.
               ls_s_xblnr_fica-option = ls_XBLNR_FICA-option.
               ls_s_xblnr_fica-sign = ls_XBLNR_FICA-sign.
            APPEND ls_s_xblnr_fica TO s_xblnr_fica.
          ENDLOOP.
    WHEN 'BELNR_FICA'.              " Equivalent to 'BelnrFica' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_BELNR_FICA ).

        LOOP AT lr_BELNR_FICA INTO ls_BELNR_FICA.
               ls_s_belnr_fica-high = ls_BELNR_FICA-high.
               ls_s_belnr_fica-low = ls_BELNR_FICA-low.
               ls_s_belnr_fica-option = ls_BELNR_FICA-option.
               ls_s_belnr_fica-sign = ls_BELNR_FICA-sign.
            APPEND ls_s_belnr_fica TO s_belnr_fica.
          ENDLOOP.
    WHEN 'SRCTAID'.              " Equivalent to 'Srctaid' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_SRCTAID ).

        LOOP AT lr_SRCTAID INTO ls_SRCTAID.
               ls_s_srctaid-high = ls_SRCTAID-high.
               ls_s_srctaid-low = ls_SRCTAID-low.
               ls_s_srctaid-option = ls_SRCTAID-option.
               ls_s_srctaid-sign = ls_SRCTAID-sign.
            APPEND ls_s_srctaid TO s_srctaid.
          ENDLOOP.
    WHEN 'VKONT'.              " Equivalent to 'Vkont' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_VKONT ).

        LOOP AT lr_VKONT INTO ls_VKONT.
               ls_s_vkont-high = ls_VKONT-high.
               ls_s_vkont-low = ls_VKONT-low.
               ls_s_vkont-option = ls_VKONT-option.
               ls_s_vkont-sign = ls_VKONT-sign.
            APPEND ls_s_vkont TO s_vkont.
          ENDLOOP.
    WHEN 'ERNAM'.              " Equivalent to 'Ernam' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_ERNAM ).

        LOOP AT lr_ERNAM INTO ls_ERNAM.
               ls_s_uname-high = ls_ERNAM-high.
               ls_s_uname-low = ls_ERNAM-low.
               ls_s_uname-option = ls_ERNAM-option.
               ls_s_uname-sign = ls_ERNAM-sign.
            APPEND ls_s_uname TO s_uname.
          ENDLOOP.
    WHEN 'RESST'.              " Equivalent to 'Resst' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_RESST ).

        LOOP AT lr_RESST INTO ls_RESST.
               ls_s_resst-high = ls_RESST-high.
