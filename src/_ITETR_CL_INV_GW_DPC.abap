 DATA lv_subrc TYPE syst-subrc.
 DATA lv_exc_msg TYPE /iwbep/mgw_bop_rfc_excep_text.
 DATA lx_root TYPE REF TO cx_root.
DATA lo_filter TYPE  REF TO /iwbep/if_mgw_req_filter.
DATA lt_filter_select_options TYPE /iwbep/t_mgw_select_option.
DATA lv_filter_str TYPE string.
DATA ls_paging TYPE /iwbep/s_mgw_paging.
DATA ls_converted_keys LIKE LINE OF et_entityset.
DATA ls_filter TYPE /iwbep/s_mgw_select_option.
DATA ls_filter_range TYPE /iwbep/s_cod_select_option.
DATA lr_P_BUKRS LIKE RANGE OF ls_converted_keys-p_bukrs.
DATA ls_P_BUKRS LIKE LINE OF lr_P_BUKRS.
DATA lr_APRVD LIKE RANGE OF ls_converted_keys-aprvd.
DATA ls_APRVD LIKE LINE OF lr_APRVD.
DATA lr_ARCHV LIKE RANGE OF ls_converted_keys-archv.
DATA ls_ARCHV LIKE LINE OF lr_ARCHV.
DATA lr_BLDAT LIKE RANGE OF ls_converted_keys-bldat.
DATA ls_BLDAT LIKE LINE OF lr_BLDAT.
DATA lr_INVNO LIKE RANGE OF ls_converted_keys-invno.
DATA ls_INVNO LIKE LINE OF lr_INVNO.
DATA lr_INVTY LIKE RANGE OF ls_converted_keys-invty.
DATA ls_INVTY LIKE LINE OF lr_INVTY.
DATA lr_INVUI LIKE RANGE OF ls_converted_keys-invui.
DATA ls_INVUI LIKE LINE OF lr_INVUI.
DATA lr_KUNNR LIKE RANGE OF ls_converted_keys-kunnr.
DATA ls_KUNNR LIKE LINE OF lr_KUNNR.
DATA lr_LIFNR LIKE RANGE OF ls_converted_keys-lifnr.
DATA ls_LIFNR LIKE LINE OF lr_LIFNR.
DATA lr_PRFID LIKE RANGE OF ls_converted_keys-prfid.
DATA ls_PRFID LIKE LINE OF lr_PRFID.
DATA lr_PRNTD LIKE RANGE OF ls_converted_keys-prntd.
DATA ls_PRNTD LIKE LINE OF lr_PRNTD.
DATA lr_PROCS LIKE RANGE OF ls_converted_keys-procs.
DATA ls_PROCS LIKE LINE OF lr_PROCS.
DATA lr_RECDT LIKE RANGE OF ls_converted_keys-recdt.
DATA ls_RECDT LIKE LINE OF lr_RECDT.
DATA lr_RESST LIKE RANGE OF ls_converted_keys-resst.
DATA ls_RESST LIKE LINE OF lr_RESST.
DATA lr_TAXID LIKE RANGE OF ls_converted_keys-taxid.
DATA ls_TAXID LIKE LINE OF lr_TAXID.
DATA lo_dp_facade TYPE REF TO /iwbep/if_mgw_dp_facade.
DATA ls_gw_et_data LIKE LINE OF et_entityset.
DATA lv_skip     TYPE int4.
DATA lv_top      TYPE int4.

*-------------------------------------------------------------
*  Map the runtime request to the RFC - Only mapped attributes
*-------------------------------------------------------------
* Get all input information from the technical request context object
* Since DPC works with internal property names and runtime API interface holds external property names
* the process needs to get the all needed input information from the technical request context object
* Get filter or select option information
  lo_filter = io_tech_request_context->get_filter( ).
  lt_filter_select_options = lo_filter->get_filter_select_options( ).
  lv_filter_str = lo_filter->get_filter_string( ).

* Check if the supplied filter is supported by standard gateway runtime process
  IF  lv_filter_str            IS NOT INITIAL
  AND lt_filter_select_options IS INITIAL.
    " If the string of the Filter System Query Option is not automatically converted into
    " filter option table (lt_filter_select_options), then the filtering combination is not supported
    " Log message in the application log
    me->/iwbep/if_sb_dpc_comm_services~log_message(
      EXPORTING
        iv_msg_type   = 'E'
        iv_msg_id     = '/IWBEP/MC_SB_DPC_ADM'
        iv_msg_number = 025 ).
     " Raise Exception
     RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception
       EXPORTING
         textid = /iwbep/cx_mgw_tech_exception=>internal_error.
  ENDIF.

* Get key table information
  io_tech_request_context->get_converted_source_keys(
    IMPORTING
      es_key_values  = ls_converted_keys ).

  ls_paging-top = io_tech_request_context->get_top( ).
  ls_paging-skip = io_tech_request_context->get_skip( ).

* Maps filter table lines to function module parameters
  LOOP AT lt_filter_select_options INTO ls_filter.

    LOOP AT ls_filter-select_options INTO ls_filter_range.
      CASE ls_filter-property.
      WHEN 'P_BUKRS'.
        lo_filter->convert_select_option(
          EXPORTING
            is_select_option = ls_filter
          IMPORTING
            et_select_option = lr_P_BUKRS ).

        READ TABLE lr_P_BUKRS INTO ls_P_BUKRS INDEX 1.
        IF sy-subrc = 0.
          p_bukrs = ls_P_BUKRS-low.
        ENDIF.
    WHEN 'APRVD'.              " Equivalent to 'Aprvd' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_APRVD ).

        LOOP AT lr_APRVD INTO ls_APRVD.
               ls_s_aprvd-high = ls_APRVD-high.
               ls_s_aprvd-low = ls_APRVD-low.
               ls_s_aprvd-option = ls_APRVD-option.
               ls_s_aprvd-sign = ls_APRVD-sign.
            APPEND ls_s_aprvd TO s_aprvd.
          ENDLOOP.
    WHEN 'ARCHV'.              " Equivalent to 'Archv' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_ARCHV ).

        LOOP AT lr_ARCHV INTO ls_ARCHV.
               ls_s_archv-high = ls_ARCHV-high.
               ls_s_archv-low = ls_ARCHV-low.
               ls_s_archv-option = ls_ARCHV-option.
               ls_s_archv-sign = ls_ARCHV-sign.
            APPEND ls_s_archv TO s_archv.
          ENDLOOP.
    WHEN 'BLDAT'.              " Equivalent to 'Bldat' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_BLDAT ).

        LOOP AT lr_BLDAT INTO ls_BLDAT.
               ls_s_bldat-high = ls_BLDAT-high.
               ls_s_bldat-low = ls_BLDAT-low.
               ls_s_bldat-option = ls_BLDAT-option.
               ls_s_bldat-sign = ls_BLDAT-sign.
            APPEND ls_s_bldat TO s_bldat.
          ENDLOOP.
    WHEN 'INVNO'.              " Equivalent to 'Invno' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_INVNO ).

        LOOP AT lr_INVNO INTO ls_INVNO.
               ls_s_invno-high = ls_INVNO-high.
               ls_s_invno-low = ls_INVNO-low.
               ls_s_invno-option = ls_INVNO-option.
               ls_s_invno-sign = ls_INVNO-sign.
            APPEND ls_s_invno TO s_invno.
          ENDLOOP.
    WHEN 'INVTY'.              " Equivalent to 'Invty' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_INVTY ).

        LOOP AT lr_INVTY INTO ls_INVTY.
               ls_s_invty-high = ls_INVTY-high.
               ls_s_invty-low = ls_INVTY-low.
               ls_s_invty-option = ls_INVTY-option.
               ls_s_invty-sign = ls_INVTY-sign.
            APPEND ls_s_invty TO s_invty.
          ENDLOOP.
    WHEN 'INVUI'.              " Equivalent to 'Invui' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_INVUI ).

        LOOP AT lr_INVUI INTO ls_INVUI.
               ls_s_invui-high = ls_INVUI-high.
               ls_s_invui-low = ls_INVUI-low.
               ls_s_invui-option = ls_INVUI-option.
               ls_s_invui-sign = ls_INVUI-sign.
            APPEND ls_s_invui TO s_invui.
          ENDLOOP.
    WHEN 'KUNNR'.              " Equivalent to 'Kunnr' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_KUNNR ).

        LOOP AT lr_KUNNR INTO ls_KUNNR.
               ls_s_kunnr-high = ls_KUNNR-high.
               ls_s_kunnr-low = ls_KUNNR-low.
               ls_s_kunnr-option = ls_KUNNR-option.
               ls_s_kunnr-sign = ls_KUNNR-sign.
            APPEND ls_s_kunnr TO s_kunnr.
          ENDLOOP.
    WHEN 'LIFNR'.              " Equivalent to 'Lifnr' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_LIFNR ).

        LOOP AT lr_LIFNR INTO ls_LIFNR.
               ls_s_lifnr-high = ls_LIFNR-high.
               ls_s_lifnr-low = ls_LIFNR-low.
               ls_s_lifnr-option = ls_LIFNR-option.
               ls_s_lifnr-sign = ls_LIFNR-sign.
            APPEND ls_s_lifnr TO s_lifnr.
          ENDLOOP.
    WHEN 'PRFID'.              " Equivalent to 'Prfid' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_PRFID ).

        LOOP AT lr_PRFID INTO ls_PRFID.
               ls_s_prfid-high = ls_PRFID-high.
               ls_s_prfid-low = ls_PRFID-low.
               ls_s_prfid-option = ls_PRFID-option.
               ls_s_prfid-sign = ls_PRFID-sign.
            APPEND ls_s_prfid TO s_prfid.
          ENDLOOP.
    WHEN 'PRNTD'.              " Equivalent to 'Prntd' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_PRNTD ).

        LOOP AT lr_PRNTD INTO ls_PRNTD.
               ls_s_prntd-high = ls_PRNTD-high.
               ls_s_prntd-low = ls_PRNTD-low.
               ls_s_prntd-option = ls_PRNTD-option.
               ls_s_prntd-sign = ls_PRNTD-sign.
            APPEND ls_s_prntd TO s_prntd.
          ENDLOOP.
    WHEN 'PROCS'.              " Equivalent to 'Procs' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_PROCS ).

        LOOP AT lr_PROCS INTO ls_PROCS.
               ls_s_procs-high = ls_PROCS-high.
               ls_s_procs-low = ls_PROCS-low.
               ls_s_procs-option = ls_PROCS-option.
               ls_s_procs-sign = ls_PROCS-sign.
            APPEND ls_s_procs TO s_procs.
          ENDLOOP.
    WHEN 'RECDT'.              " Equivalent to 'Recdt' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_RECDT ).

        LOOP AT lr_RECDT INTO ls_RECDT.
               ls_s_recdt-high = ls_RECDT-high.
               ls_s_recdt-low = ls_RECDT-low.
               ls_s_recdt-option = ls_RECDT-option.
               ls_s_recdt-sign = ls_RECDT-sign.
            APPEND ls_s_recdt TO s_recdt.
          ENDLOOP.
    WHEN 'RESST'.              " Equivalent to 'Resst' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_RESST ).

        LOOP AT lr_RESST INTO ls_RESST.
               ls_s_resst-high = ls_RESST-high.
               ls_s_resst-low = ls_RESST-low.
               ls_s_resst-option = ls_RESST-option.
               ls_s_resst-sign = ls_RESST-sign.
            APPEND ls_s_resst TO s_resst.
          ENDLOOP.
    WHEN 'TAXID'.              " Equivalent to 'Taxid' property in the service
      lo_filter->convert_select_option(
        EXPORTING
          is_select_option = ls_filter
        IMPORTING
          et_select_option = lr_TAXID ).

        LOOP AT lr_TAXID INTO ls_TAXID.
               ls_s_taxid-high = ls_TAXID-high.
               ls_s_taxid-low = ls_TAXID-low.
               ls_s_taxid-option = ls_TAXID-option.
               ls_s_taxid-sign = ls_TAXID-sign.
            APPEND ls_s_taxid TO s_taxid.
          ENDLOOP.

        WHEN OTHERS.
          " Log message in the application log
          me->/iwbep/if_sb_dpc_comm_services~log_message(
            EXPORTING
              iv_msg_type   = 'E'
              iv_msg_id     = '/IWBEP/MC_SB_DPC_ADM'
              iv_msg_number = 020
              iv_msg_v1     = ls_filter-property ).
          " Raise Exception
          RAISE EXCEPTION TYPE /iwbep/cx_mgw_tech_exception
            EXPORTING
              textid = /iwbep/cx_mgw_tech_exception=>internal_error.
        ENDCASE.
    ENDLOOP.

  ENDLOOP.

* Get RFC destination
lo_dp_facade = /iwbep/if_mgw_conv_srv_runtime~get_dp_facade( ).
lv_destination = /iwbep/cl_sb_gen_dpc_rt_util=>get_rfc_destination( io_dp_facade = lo_dp_facade ).

*-------------------------------------------------------------
*  Call RFC function module
*-------------------------------------------------------------
lv_rfc_name = '/ITETR/INV_INCINV_LIST'.

IF lv_destination IS INITIAL OR lv_destination EQ 'NONE'.

  TRY.
      CALL FUNCTION lv_rfc_name
        EXPORTING
          s_aprvd   =   s_aprvd
          s_archv   =   s_archv
          s_bldat   =   s_bldat
          s_invno   =   s_invno
          s_invty   =   s_invty
          s_invui   =   s_invui
          s_kunnr   =   s_kunnr
          s_lifnr   =   s_lifnr
          s_prfid   =   s_prfid
          s_prntd   =   s_prntd
          s_procs   =   s_procs
          s_recdt   =   s_recdt
          s_resst   =   s_resst
          s_taxid   =   s_taxid
          p_bukrs   =   p_bukrs
        IMPORTING
          et_data   =   et_data
        EXCEPTIONS
          system_failure = 1000 message lv_exc_msg
          OTHERS = 1002.

      lv_subrc = sy-subrc.
*in case of co-deployment the exception is raised and needs to be caught
    CATCH cx_root INTO lx_root.
      lv_subrc = 1001.
      lv_exc_msg = lx_root->if_message~get_text( ).
  ENDTRY.

ELSE.

  CALL FUNCTION lv_rfc_name DESTINATION lv_destination
        EXPORTING
          s_aprvd   =   s_aprvd
          s_archv   =   s_archv
          s_bldat   =   s_bldat
          s_invno   =   s_invno
          s_invty   =   s_invty
          s_invui   =   s_invui
          s_kunnr   =   s_kunnr
          s_lifnr   =   s_lifnr
          s_prfid   =   s_prfid
          s_prntd   =   s_prntd
          s_procs   =   s_procs
          s_recdt   =   s_recdt
          s_resst   =   s_resst
          s_taxid   =   s_taxid
          p_bukrs   =   p_bukrs
        IMPORTING
          et_data   =   et_data
        EXCEPTIONS
          system_failure         = 1000 MESSAGE lv_exc_msg
          communication_failure  = 1001 MESSAGE lv_exc_msg
          OTHERS = 1002.

  lv_subrc = sy-subrc.

ENDIF.

*-------------------------------------------------------------
*  Map the RFC response to the caller interface - Only mapped attributes
*-------------------------------------------------------------
*-------------------------------------------------------------
* Error and exception handling
*-------------------------------------------------------------
IF lv_subrc <> 0.
* Execute the RFC exception handling process
  me->/iwbep/if_sb_dpc_comm_services~rfc_exception_handling(
    EXPORTING
      iv_subrc            = lv_subrc
      iv_exp_message_text = lv_exc_msg ).
ENDIF.

*-------------------------------------------------------------------------*
*             - Post Backend Call -
*-------------------------------------------------------------------------*
IF ls_paging-skip IS NOT INITIAL.
*  If the Skip value was requested at runtime
*  the response table will provide backend entries from skip + 1, meaning start from skip +1
*  for example: skip=5 means to start get results from the 6th row
  lv_skip = ls_paging-skip + 1.
ENDIF.
*  The Top value was requested at runtime but was not handled as part of the function interface
IF  ls_paging-top <> 0
AND lv_skip IS NOT INITIAL.
*  if lv_skip > 0 retrieve the entries from lv_skip + Top - 1
*  for example: skip=5 and top=2 means to start get results from the 6th row and end in row number 7
lv_top = ls_paging-top + lv_skip - 1.
ELSEIF ls_paging-top <> 0
AND    lv_skip IS INITIAL.
  lv_top = ls_paging-top.
ELSE.
  lv_top = lines( et_data ).
ENDIF.

*  - Map properties from the backend to the Gateway output response table -

LOOP AT et_data INTO ls_et_data
*  Provide the response entries according to the Top and Skip parameters that were provided at runtime
     FROM lv_skip TO lv_top.
*  Only fields that were mapped will be delivered to the response table
 ls_gw_et_data-staic = ls_et_data-staic.
 ls_gw_et_data-invno = ls_et_data-invno.
 ls_gw_et_data-invui = ls_et_data-invui.
 ls_gw_et_data-docui = ls_et_data-docui.
 ls_gw_et_data-lifnr = ls_et_data-lifnr.
 ls_gw_et_data-kunnr = ls_et_data-kunnr.
 ls_gw_et_data-taxid = ls_et_data-taxid.
 ls_gw_et_data-vknid = ls_et_data-vknid.
 ls_gw_et_data-title = ls_et_data-title.
 ls_gw_et_data-bldat = ls_et_data-bldat.
 ls_gw_et_data-recdt = ls_et_data-recdt.
 ls_gw_et_data-rdays = ls_et_data-rdays.
 ls_gw_et_data-dmbtr = ls_et_data-dmbtr.
 ls_gw_et_data-wrbtr = ls_et_data-wrbtr.
 ls_gw_et_data-fwste = ls_et_data-fwste.
 ls_gw_et_data-waers = ls_et_data-waers.
 ls_gw_et_data-prfid = ls_et_data-prfid.
 ls_gw_et_data-invty = ls_et_data-invty.
 ls_gw_et_data-attex = ls_et_data-attex.
 ls_gw_et_data-prntd = ls_et_data-prntd.
 ls_gw_et_data-aprvd = ls_et_data-aprvd.
 ls_gw_et_data-procs = ls_et_data-procs.
 ls_gw_et_data-awtyp = ls_et_data-awtyp.
 ls_gw_et_data-belnr = ls_et_data-belnr.
 ls_gw_et_data-gjahr = ls_et_data-gjahr.
 ls_gw_et_data-archv = ls_et_data-archv.
 ls_gw_et_data-resst = ls_et_data-resst.
 ls_gw_et_data-resst_txt = ls_et_data-resst_txt.
 ls_gw_et_data-radsc = ls_et_data-radsc.
 ls_gw_et_data-staex = ls_et_data-staex.
 ls_gw_et_data-stats = ls_et_data-stats.
 ls_gw_et_data-lnote = ls_et_data-lnote.
 ls_gw_et_data-logic = ls_et_data-logic.
 ls_gw_et_data-despid = ls_et_data-despid.
 ls_gw_et_data-orderid = ls_et_data-orderid.
 ls_gw_et_data-withholding = ls_et_data-withholding.
 ls_gw_et_data-allowance = ls_et_data-allowance.
 ls_gw_et_data-draft = ls_et_data-draft.
 ls_gw_et_data-statu = ls_et_data-statu.
 ls_gw_et_data-statu_date = ls_et_data-statu_date.
APPEND ls_gw_et_data TO et_entityset.
CLEAR ls_gw_et_data.
ENDLOOP.

  endmethod.


